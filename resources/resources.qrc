<RCC>
    <!-- ── Styles ─────────────────────────────────────── -->
    <qresource prefix="/styles">
        <file alias="main.qss">styles/main.qss</file>
    </qresource>

    <!-- ── Menu ───────────────────────────────────────── -->
    <qresource prefix="/images/menu">
        <file alias="menu.png">images/menu.png</file>
    </qresource>

    <!-- ── Chapter 1: 少女！从沉睡中苏醒 ──────────────── -->
    <qresource prefix="/images/ch01">
        <file alias="YAN_Start1.png">images/ch01_awaken/YAN_Start1.png</file>
        <file alias="YAN_Start2.png">images/ch01_awaken/YAN_Start2.png</file>
        <file alias="YAN_Start3.png">images/ch01_awaken/YAN_Start3.png</file>
    </qresource>

    <!-- ── Chapter 2: 少女！决战梨花怪 ────────────────── -->
    <qresource prefix="/images/ch02">
        <file alias="YAN_Appear_Peach.png">images/ch02_peach/YAN_Appear_Peach.png</file>
        <file alias="YAN_Fight_Peach.png">images/ch02_peach/YAN_Fight_Peach.png</file>
        <file alias="YAN_Defeat_Peach.png">images/ch02_peach/YAN_Defeat_Peach.png</file>
    </qresource>

    <!-- ── Chapter 3: 少女！向天空高举叛逆之拳 ────────── -->
    <qresource prefix="/images/ch03">
        <file alias="YAN_Fight_XIA.png">images/ch03_rebellion/YAN_Fight_XIA.png</file>
        <file alias="XIA_Die1.png">images/ch03_rebellion/XIA_Die1.png</file>
        <file alias="XIA_Die2.png">images/ch03_rebellion/XIA_Die2.png</file>
    </qresource>

    <!-- ── Chapter 4: 少女！最后的幸存者 ──────────────── -->
    <qresource prefix="/images/ch04">
        <file alias="YAN_ShangHai.png">images/ch04_survivor/YAN_ShangHai.png</file>
    </qresource>

    <!-- ── Chapter 5: 少女！银河告别旅行 ──────────────── -->
    <qresource prefix="/images/ch05">
        <file alias="YAN_Chirsmas.png">images/ch05_farewell/YAN_Chirsmas.png</file>
        <file alias="YAN_Eating.png">images/ch05_farewell/YAN_Eating.png</file>
        <file alias="YAN_Farewell.jpg">images/ch05_farewell/YAN_Farewell.jpg</file>
        <file alias="YAN_Graduate.jpg">images/ch05_farewell/YAN_Graduate.jpg</file>
        <file alias="YAN_Janpan.png">images/ch05_farewell/YAN_Janpan.png</file>
        <file alias="YAN_Memory.png">images/ch05_farewell/YAN_Memory.png</file>
        <file alias="YAN_NewYork.png">images/ch05_farewell/YAN_NewYork.png</file>
        <file alias="YAN_ShangHai.png">images/ch05_farewell/YAN_ShangHai.png</file>
        <file alias="YAN_Sleep.png">images/ch05_farewell/YAN_Sleep.png</file>
        <file alias="YAN_Train.jpg">images/ch05_farewell/YAN_Train.jpg</file>
    </qresource>

    <!-- ── Map Sprites ────────────────────────────────── -->
    <qresource prefix="/images/maps">
        <file alias="sunflower.png">images/Map/向日葵/修改精灵图文件(1).png</file>
        <file alias="skybridge.png">images/Map/天桥/修改精灵图文件(2).png</file>
        <file alias="ruins.png">images/Map/废墟/修改精灵图文件(6).png</file>
        <file alias="peach_forest.png">images/Map/桃林/修改精灵图文件(4).png</file>
        <file alias="newyork.png">images/Map/纽约/修改精灵图文件(3).png</file>
        <file alias="snow_mountain.png">images/Map/雪山/修改精灵图文件(5).png</file>
    </qresource>

