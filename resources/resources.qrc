    <!-- ── Videos: Chapter 3 ──────────────────────────── -->
    <qresource prefix="/videos/ch03">
        <file alias="action_frame_gen.mp4">videos/ch03_rebellion/动作帧生成.mp4</file>
    </qresource>

    <!-- ── Videos: Chapter 4 ──────────────────────────── -->
    <qresource prefix="/videos/ch04">
        <file alias="Video_YAN_Map.mp4">videos/ch04_survivor/Video_YAN_Map.mp4</file>
        <file alias="Video_YAN_Tark.mp4">videos/ch04_survivor/Video_YAN_Tark.mp4</file>
