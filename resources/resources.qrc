<RCC>
    <!-- Stylesheet -->
    <qresource prefix="/styles">
        <file alias="main.qss">styles/main.qss</file>
    </qresource>

    <!-- Title Bar Icons -->
    <qresource prefix="/images/ui">
        <file alias="close.png">../icon/close.png</file>
        <file alias="max.png">../icon/max.png</file>
        <file alias="mini.png">../icon/mini.png</file>
    </qresource>

    <!--
      ALL images (~181 MB) and videos are COPIED to the build output
      by CMake and loaded from disk via GameConfig::imagePath().

      Code uses :/images/... prefix; GameConfig converts to
        <appdir>/images/...  at runtime.

      Directory names match Farewell_Trip.doc:
        resources/images/ch01_awaken/   -> build/images/ch01_awaken/
        resources/images/ch02_peach/    -> build/images/ch02_peach/
        resources/images/ch03_rebellion/ -> build/images/ch03_rebellion/
        resources/images/ch04_survivor/ -> build/images/ch04_survivor/
        resources/images/ch05_farewell/ -> build/images/ch05_farewell/
        resources/images/YAN_Action/    -> build/images/YAN_Action/
        resources/images/Peach_Action/  -> build/images/Peach_Action/
        resources/images/XIA_Action/    -> build/images/XIA_Action/
        resources/images/Doc_Action/    -> build/images/Doc_Action/
        resources/images/Map/           -> build/images/Map/
        resources/videos/               -> build/videos/
    -->
</RCC>
